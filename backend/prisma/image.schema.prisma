// Image Database Schema
// Generated Client: src/generated/image-client
// Version: 1.0
// Last Updated: 2026-05-17

generator clientImage {
  provider = "prisma-client-js"
  binaryTargets = ["native","debian-openssl-3.0.x"]
  output   = "../src/generated/image-client"
}

datasource dbImage {
  provider = "postgresql"
  url      = env("IMG_URL")
}

model Image {
  id        String      @id @default(uuid())
  name      String      @unique
  data      Bytes

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([name])
  @@map("images")
}