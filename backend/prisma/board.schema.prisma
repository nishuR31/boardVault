// Board Database Schema
// Generated Client: src/generated/board-client
// Version: 1.0
// Last Updated: 2026-05-17

generator clientBoard {
  provider = "prisma-client-js"
  binaryTargets = ["native","debian-openssl-3.0.x"]

  output   = "../src/generated/board-client"
}

datasource dbBoard {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum BoardType {
  SBC
  MC

  @@map("board_type")
}


model Board {
  id           String      @id @default(uuid())

  name         String      @unique
  slug         String      @unique

  type         BoardType

  description  String

  category     String[]
  bestFor      String[]
  alternatives String[]

  photoFrontId String?
  pinDiagramId String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([name])
  @@index([slug])
  @@index([type])

  @@map("boards")
}